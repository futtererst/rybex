# RybexOS environment example
#
# Seed mode is the default and does not require database variables.
RYBEXOS_DATA_SOURCE=seed

# Auth remains demo-only by default. Supabase auth is a future foundation mode.
RYBEXOS_AUTH_MODE=demo

# Workflow transactions remain local/demo state by default.
RYBEXOS_WORKFLOW_TRANSACTION_STORE=local

# Workflow completions remain local/demo state by default.
RYBEXOS_WORKFLOW_COMPLETION_STORE=local

# Evidence actions remain local/demo state by default.
RYBEXOS_EVIDENCE_STORE=local

# To test the database read pilot locally:
# RYBEXOS_DATA_SOURCE=database
# RYBEXOS_WORKFLOW_TRANSACTION_STORE=local
#
# To test the workflow transaction write pilot locally:
# RYBEXOS_DATA_SOURCE=database
# RYBEXOS_WORKFLOW_TRANSACTION_STORE=database
#
# To test the workflow completion persistence pilot locally:
# RYBEXOS_DATA_SOURCE=database
# RYBEXOS_WORKFLOW_COMPLETION_STORE=database
#
# To test the evidence upload pilot locally:
# RYBEXOS_DATA_SOURCE=database
# RYBEXOS_EVIDENCE_STORE=database

# Future Supabase variables. Leave blank in seed mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Compatibility aliases supported by the database pilot.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this key to client-side code.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
