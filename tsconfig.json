{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-review-61430/types/**/*.ts",
    ".next-review-61430/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "package-output",
    "dist-demo",
    "out",
    "artifacts",
    "visual-qa-output",
    ".next/dev",
    ".agents",
    ".codex",
    ".rybexos-local",
    ".tmp",
    "components/d5o/workflow/WorkflowTransactionRuntime.tsx"
  ]
}
